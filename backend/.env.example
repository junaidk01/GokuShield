# ===========================================
# GokuShield AI v1.0 - Environment Variables
# ===========================================
# Copy this file to .env and fill in the values
# NEVER commit .env to version control

# ----- Database (Oracle Cloud) -----
DATABASE_URL=oracle://username:password@host:port/service_name
DATABASE_POOL_SIZE=10
DATABASE_POOL_MAX_OVERFLOW=20

# ----- JWT & Security -----
# Generate with: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_STRONG_SECRET_32_CHARS_MIN
JWT_ALGORITHM=HS256
JWT_CLIENT_EXPIRATION=7d
JWT_ADMIN_EXPIRATION=1d

# Admin JWT uses separate secret for isolation
ADMIN_JWT_SECRET=REPLACE_WITH_DIFFERENT_STRONG_SECRET

# ----- Domains -----
WEBSITE_DOMAIN=www.gokushield.com
ADMIN_DOMAIN=admin.gokushield.com
CLIENT_DOMAIN_PATTERN=*.gokushield.com
API_DOMAIN=api.gokushield.com

# ----- Email Service -----
EMAIL_PROVIDER=smtp
EMAIL_FROM=noreply@gokushield.com
EMAIL_REPLY_TO=support@gokushield.com
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=your-smtp-username
EMAIL_SMTP_PASS=your-smtp-password
EMAIL_USE_TLS=true

# ----- Google reCAPTCHA v3 -----
# Get keys from: https://www.google.com/recaptcha/admin
RECAPTCHA_SITE_KEY=6LcExample_SITE_KEY_REPLACE_THIS
RECAPTCHA_SECRET_KEY=6LcExample_SECRET_KEY_REPLACE_THIS
RECAPTCHA_MIN_SCORE=0.5

# ----- Ollama (AI Engine) -----
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama2:latest
OLLAMA_TIMEOUT=60
OLLAMA_MAX_TOKENS=2048
OLLAMA_TEMPERATURE=0.3

# ----- Redis (Sessions & Rate Limiting) -----
REDIS_URL=redis://localhost:6379/0
REDIS_SESSION_DB=1
REDIS_RATE_LIMIT_DB=2

# ----- Object Storage (PDF Reports) -----
STORAGE_PROVIDER=oracle_cloud
STORAGE_BUCKET=gokushield-reports
STORAGE_REGION=us-ashburn-1
STORAGE_ACCESS_KEY=your-storage-access-key
STORAGE_SECRET_KEY=your-storage-secret-key

# ----- Rate Limiting -----
RATE_LIMIT_AUDIT_PER_DAY=1
RATE_LIMIT_SCANNER_PER_HOUR=10
RATE_LIMIT_FORMS_PER_HOUR=5

# ----- Security -----
ALLOWED_ORIGINS=https://www.gokushield.com,https://admin.gokushield.com
CORS_MAX_AGE=86400
COOKIE_SECURE=true
COOKIE_HTTPONLY=true
COOKIE_SAMESITE=Strict
SESSION_LIFETIME=3600

# ----- MFA (Admin Only) -----
MFA_ISSUER=GokuShield Admin
MFA_SESSION_TIMEOUT=3600

# ----- Logging & Monitoring -----
LOG_LEVEL=info
LOG_FILE=/var/log/gokushield/app.log
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
ENABLE_METRICS=true

# ----- Application Settings -----
DEBUG=false
ENV=production
VERSION=1.0
MAX_AUDIT_APIS=50
PDF_GENERATION_TIMEOUT=120

# ----- Webhook URLs (Optional) -----
# Slack notifications for critical events
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
# Payment webhooks (Stripe, etc.)
PAYMENT_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# ----- Backup & Maintenance -----
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
