# Get this from @BotFather on Telegram (see TELEGRAM_SETUP_GUIDE.md)
TELEGRAM_BOT_TOKEN=REPLACE_WITH_BOTFATHER_TOKEN

# Where the GokuShield backend API is reachable from wherever this bot runs.
# Inside docker-compose, this is the service name; if you deploy the bot
# separately, use your public API domain instead.
GOKUSHIELD_API_URL=http://backend:5000

# Comma-separated Telegram numeric user IDs allowed to use /pending,
# /approve, /reject. Get your own ID by messaging @userinfobot on Telegram.
ADMIN_TELEGRAM_IDS=

# A real GokuShield admin account (created via your normal admin flow).
# The bot logs in with these to call the admin remediation-queue API —
# it does not get elevated access some other way.
GOKUSHIELD_ADMIN_EMAIL=
GOKUSHIELD_ADMIN_PASSWORD=
